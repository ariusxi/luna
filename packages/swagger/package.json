    "build:watch": "rollup -c --watch",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "swagger-ui-dist": "^5.17.14"
  },
  "peerDependencies": {
    "@lunafw/common": "*",
    "@lunafw/core": "*",
