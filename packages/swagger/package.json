  },
  "devDependencies": {
    "@lunafw/common": "*",
    "@lunafw/core": "*",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/swagger-ui-dist": "^3.30.5",
    "jest": "^30.4.2",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^5.3.1",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
