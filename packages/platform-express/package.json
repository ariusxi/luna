{
  "name": "@lunafw/platform-express",
  "version": "0.1.0",
  "description": "Express adapter for the Luna framework — HTTP routing and exception handling",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.esm.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "@lunafw/common": "*",
    "@lunafw/core": "*",
    "express": "^4.0.0 || ^5.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^6.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^4.21.2",
    "jest": "^30.4.2",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^5.3.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "files": [
    "dist"
  ],
