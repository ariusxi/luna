{
  "name": "@lunafw/platform-grpc",
  "version": "0.1.0",
  "description": "gRPC adapter for the Luna framework",
  "keywords": [
    "luna",
    "lunafw",
    "grpc",
    "rpc",
    "framework",
    "adapter",
    "typescript",
    "nodejs"
  ],
  "author": "Alef Felix",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/ariusxi/luna#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ariusxi/luna.git",
    "directory": "packages/platform-grpc"
  },
  "bugs": {
    "url": "https://github.com/ariusxi/luna/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.0.0",
    "@grpc/proto-loader": "^0.7.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@lunafw/common": "*",
    "@lunafw/core": "*",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^26.0.1",
    "jest": "^30.4.2",
    "rollup": "^4.43.0",
    "ts-jest": "^29.4.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
