{
  "name": "@lunafw/common",
  "version": "0.1.0",
  "description": "Common abstractions, decorators, guards, pipes and interceptors for the Luna framework",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.esm.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "@lunafw/core": "*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^5.3.1",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "luna",
    "lunafw",
    "framework",
    "backend",
    "typescript",
    "decorators",
    "guards",
    "pipes",
    "interceptors",
    "controller",
    "protocol-agnostic",
    "reflect-metadata"
  ],
  "license": "MIT",
  "author": "Alef Felix <alef.developerweb@gmail.com>",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@lunafw/core": "*"
  },
  "homepage": "https://github.com/ariusxi/luna#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ariusxi/luna.git",
    "directory": "packages/common"
  },
  "bugs": {
    "url": "https://github.com/ariusxi/luna/issues"
  }
}
